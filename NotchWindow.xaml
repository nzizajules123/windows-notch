<Window x:Class="WindowsNotch.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WindowsNotch"
        xmlns:ui="clr-namespace:WindowsNotch.UI"
        Title="Windows Notch"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" ShowActivated="False"
        Width="780" Height="380"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Foreground="{StaticResource Fg}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <ItemsPanelTemplate x:Key="Wrap"><WrapPanel/></ItemsPanelTemplate>

        <!-- App tile -->
        <DataTemplate x:Key="AppTile">
            <Grid x:Name="root" Width="84" Height="78" Margin="0,0,7,7">
                <Button Style="{StaticResource TileButton}" Click="App_Click" Tag="{Binding}" ToolTip="{Binding Title}">
                    <StackPanel>
                        <Grid Width="32" Height="32">
                            <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.45"/></Image.Effect>
                            </Image>
                            <Border CornerRadius="9" Background="{StaticResource GradLock}" Visibility="{Binding InitialVisibility}">
                                <TextBlock Text="{Binding Initial}" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding Name}" FontSize="10.5" Margin="4,7,4,0" MaxWidth="76"
                                   TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="closeBtn" Style="{StaticResource IconButton}" Width="20" Height="20" Background="#99202024"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0"
                        Click="AppClose_Click" Tag="{Binding}" ToolTip="Close window" Opacity="0">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" FontSize="8"/>
                </Button>
            </Grid>
            <DataTemplate.Triggers>
                <Trigger SourceName="root" Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions><BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetName="closeBtn" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                    </Storyboard></BeginStoryboard></Trigger.EnterActions>
                    <Trigger.ExitActions><BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetName="closeBtn" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                    </Storyboard></BeginStoryboard></Trigger.ExitActions>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Shelf tile -->
        <DataTemplate x:Key="ShelfTile">
            <Grid x:Name="root" Width="84" Height="78" Margin="0,0,7,7" Opacity="{Binding Dim}" Background="Transparent"
                  ToolTip="{Binding Tip}" Cursor="Hand" RenderTransformOrigin="0.5,0.5"
                  PreviewMouseLeftButtonDown="ShelfItem_MouseDown" MouseMove="ShelfItem_MouseMove"
                  MouseRightButtonUp="ShelfItem_RightClick">
                <Grid.RenderTransform><ScaleTransform/></Grid.RenderTransform>
                <Border CornerRadius="14" Background="{StaticResource GlassFill}" BorderBrush="{StaticResource GlassStroke}" BorderThickness="1"/>
                <Border x:Name="hl" CornerRadius="14" Background="{StaticResource GlassHover}" Opacity="0"/>
                <StackPanel VerticalAlignment="Center">
                    <Grid Width="32" Height="32">
                        <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.45"/></Image.Effect>
                        </Image>
                        <Border CornerRadius="9" Background="{StaticResource GradSleep}" Visibility="{Binding InitialVisibility}">
                            <TextBlock Text="{Binding Initial}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding Name}" FontSize="10.5" Margin="4,7,4,0" MaxWidth="76"
                               TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
                </StackPanel>
                <Button x:Name="removeBtn" Style="{StaticResource IconButton}" Width="20" Height="20" Background="#99202024"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0"
                        Click="ShelfRemove_Click" Tag="{Binding}" ToolTip="Remove from shelf" Opacity="0">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" FontSize="8"/>
                </Button>
            </Grid>
            <DataTemplate.Triggers>
                <Trigger SourceName="root" Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions><BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetName="removeBtn" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                        <DoubleAnimation Storyboard.TargetName="hl" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                        <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.045" Duration="0:0:0.32"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.5" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.045" Duration="0:0:0.32"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.5" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                    </Storyboard></BeginStoryboard></Trigger.EnterActions>
                    <Trigger.ExitActions><BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetName="removeBtn" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                        <DoubleAnimation Storyboard.TargetName="hl" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25"/>
                        <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.3"/>
                        <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.3"/>
                    </Storyboard></BeginStoryboard></Trigger.ExitActions>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="Root">
        <!-- coloured halo (artwork colour) + depth shadow, both only when open -->
        <Border x:Name="NotchGlow" HorizontalAlignment="Center" VerticalAlignment="Top" Opacity="0" IsHitTestVisible="False"
                Width="{Binding ActualWidth, ElementName=Notch}" Height="{Binding ActualHeight, ElementName=Notch}"
                Background="Black" CornerRadius="{Binding CornerRadius, ElementName=Notch}">
            <Border.Effect><DropShadowEffect x:Name="NotchGlowFx" BlurRadius="60" ShadowDepth="10" Direction="270" Opacity="0.55"/></Border.Effect>
        </Border>
        <Border x:Name="NotchShadow" HorizontalAlignment="Center" VerticalAlignment="Top" Opacity="0" IsHitTestVisible="False"
                Width="{Binding ActualWidth, ElementName=Notch}" Height="{Binding ActualHeight, ElementName=Notch}"
                Background="Black" CornerRadius="{Binding CornerRadius, ElementName=Notch}">
            <Border.Effect><DropShadowEffect BlurRadius="26" ShadowDepth="6" Direction="270" Opacity="0.7" Color="Black"/></Border.Effect>
        </Border>

        <StackPanel x:Name="NotchHost" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top">
            <!-- concave "ears" that melt the island into the top edge of the screen -->
            <Path x:Name="EarL" Data="M0,0 L12,0 L12,12 A12,12 0 0 0 0,0 Z" Fill="Black" VerticalAlignment="Top" Width="12" Height="12"/>

            <Border x:Name="Notch" Width="230" Height="32" Background="{StaticResource NotchFill}" CornerRadius="0,0,16,16"
                    AllowDrop="True"
                    MouseEnter="Notch_MouseEnter" MouseLeave="Notch_MouseLeave"
                    DragEnter="Notch_DragEnter" DragOver="Notch_DragOver" DragLeave="Notch_DragLeave" Drop="Notch_Drop">
                <Grid x:Name="NotchContent">

                    <!-- ===== frosted glass: a blurred picture of the desktop behind the open notch ===== -->
                    <Image x:Name="FrostImage" Opacity="0" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Top" IsHitTestVisible="False">
                        <Image.Effect><BlurEffect Radius="60" KernelType="Gaussian" RenderingBias="Quality"/></Image.Effect>
                    </Image>

                    <!-- ===== ambient backdrop: blurred, slowly drifting artwork ===== -->
                    <Grid x:Name="Ambient" Opacity="0" IsHitTestVisible="False">
                        <!-- dark vibrancy over the frosted desktop so text always reads -->
                        <Rectangle Fill="#A6141418"/>
                        
                        <Image x:Name="AmbientImage" Stretch="UniformToFill" Opacity="0.5" RenderTransformOrigin="0.5,0.5">
                            <Image.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="AmbientScale" ScaleX="1.4" ScaleY="1.4"/>
                                    <RotateTransform x:Name="AmbientRotate"/>
                                </TransformGroup>
                            </Image.RenderTransform>
                            <Image.Effect><BlurEffect Radius="70" RenderingBias="Performance"/></Image.Effect>
                        </Image>
                        <Rectangle x:Name="MediaWash" Fill="{DynamicResource AccentWash}"/>
                        <Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#14000000" Offset="0"/><GradientStop Color="#59000000" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
                    </Grid>

                    <!-- hairline rim -->
                    <Border x:Name="Rim" BorderBrush="{StaticResource RimStroke}" BorderThickness="1" Opacity="0" IsHitTestVisible="False"
                            CornerRadius="{Binding CornerRadius, ElementName=Notch}"/>

                    <!-- breathing accent line along the bottom while music plays (collapsed) -->
                    <Grid x:Name="LiveGlowHost" VerticalAlignment="Bottom" Height="6" Opacity="0" IsHitTestVisible="False" Margin="26,0,26,0">
                        <Rectangle x:Name="LiveGlowLine" Height="1.5" VerticalAlignment="Bottom" Fill="{DynamicResource AccentLine}">
                            <Rectangle.Effect><DropShadowEffect x:Name="LiveGlowFx" BlurRadius="10" ShadowDepth="0" Opacity="1"/></Rectangle.Effect>
                        </Rectangle>
                    </Grid>

                    <!-- ===================== COLLAPSED ===================== -->
                    <Grid x:Name="CollapsedView" VerticalAlignment="Top">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Margin="12,0,13,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- the little face in the middle -->
                            <ui:NotchEyes x:Name="Eyes" Grid.Column="1" Margin="2,0" VerticalAlignment="Center"/>

                            <!-- HUD: volume / brightness / network (replaces the side content for a moment) -->
                            <StackPanel x:Name="HudLeft" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                                <Border x:Name="HudIconBox" Width="20" Height="20" CornerRadius="7" Background="#24FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform><ScaleTransform x:Name="HudIconScale"/></Border.RenderTransform>
                                    <Border.Effect><DropShadowEffect x:Name="HudGlowFx" BlurRadius="10" ShadowDepth="0" Opacity="0"/></Border.Effect>
                                    <TextBlock x:Name="HudIcon" Style="{StaticResource Glyph}" FontSize="11" Foreground="{StaticResource Fg}"/>
                                </Border>
                                <TextBlock x:Name="HudLabel" FontSize="12" FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" MaxWidth="108"/>
                            </StackPanel>
                            <StackPanel x:Name="HudRight" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed">
                                <Border x:Name="HudTrack" Width="58" Height="5" CornerRadius="2.5" Background="#26FFFFFF" VerticalAlignment="Center">
                                    <Border x:Name="HudFill" HorizontalAlignment="Left" Width="0" CornerRadius="2.5" Background="{DynamicResource AccentGradientH}">
                                        <Border.Effect><DropShadowEffect x:Name="HudBarGlowFx" BlurRadius="8" ShadowDepth="0" Opacity="0.9"/></Border.Effect>
                                    </Border>
                                </Border>
                                <TextBlock x:Name="HudValue" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource FgDim}" Margin="7,0,0,0"
                                           MinWidth="22" TextAlignment="Right" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- LIVE ACTIVITY: something (Claude, a build, a terminal job…) is working -->
                            <StackPanel x:Name="LiveLeft" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                                <Grid Width="24" Height="24">
                                    <Border Width="18" Height="18" CornerRadius="6" Background="#1FFFFFFF">
                                        <Grid>
                                            <Image x:Name="LiveIcon" Width="13" Height="13" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <TextBlock x:Name="LiveInitial" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <Ellipse x:Name="LiveRing" Width="24" Height="24" StrokeThickness="1.8" StrokeDashArray="7 5" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform><RotateTransform x:Name="LiveRingSpin"/></Ellipse.RenderTransform>
                                        <Ellipse.Effect><DropShadowEffect x:Name="LiveRingGlow" BlurRadius="8" ShadowDepth="0" Opacity="0.9"/></Ellipse.Effect>
                                    </Ellipse>
                                </Grid>
                                <TextBlock x:Name="LiveApp" FontSize="11.5" FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" MaxWidth="92"/>
                            </StackPanel>
                            <StackPanel x:Name="LiveRight" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed">
                                <StackPanel x:Name="LiveDots" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,7,0">
                                    <Ellipse x:Name="LiveDot1" Width="4" Height="4" Margin="1,0"/>
                                    <Ellipse x:Name="LiveDot2" Width="4" Height="4" Margin="1,0"/>
                                    <Ellipse x:Name="LiveDot3" Width="4" Height="4" Margin="1,0"/>
                                </StackPanel>
                                <TextBlock x:Name="LiveTime" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                            </StackPanel>

                            <StackPanel x:Name="MiniLeft" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="MiniThumb" Width="20" Height="20" CornerRadius="6" Margin="0,0,8,0" Visibility="Collapsed"
                                        Background="{StaticResource GlassFill}" RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform><ScaleTransform x:Name="MiniThumbScale"/></Border.RenderTransform>
                                    <Border x:Name="MiniThumbImg" CornerRadius="6">
                                        <Border.Background><ImageBrush x:Name="MiniThumbBrush" Stretch="UniformToFill"/></Border.Background>
                                    </Border>
                                </Border>
                                <TextBlock x:Name="MiniTime" Text="12:00" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel x:Name="MiniRight" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Grid x:Name="MiniCamDot" Width="8" Height="8" Margin="0,0,9,0" VerticalAlignment="Center" Visibility="Collapsed"
                                      ToolTip="Gesture camera is watching">
                                    <Ellipse Fill="{StaticResource GradCamera}">
                                        <Ellipse.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#FF30D158" Opacity="0.9"/></Ellipse.Effect>
                                    </Ellipse>
                                </Grid>
                                <ui:EqualizerBars x:Name="MiniEq" BarHeight="14" BarWidth="3" Margin="0,0,10,0" Visibility="Collapsed"/>
                                <local:BatteryIndicator x:Name="MiniBattery"/>
                            </StackPanel>
                        </Grid>

                        <!-- live line: lyric / caption / gesture hold -->
                        <Grid x:Name="Ticker" Grid.Row="1" Height="22" Margin="18,0,18,7" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top">
                                <TextBlock x:Name="TickerNote" Text="♪" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentGradient}"
                                           Margin="0,0,7,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                                <TextBlock x:Name="TickerText" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource FgDim}"
                                           TextTrimming="CharacterEllipsis" MaxWidth="330" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border x:Name="HoldTrack" Height="3" VerticalAlignment="Bottom" CornerRadius="1.5" Background="#1FFFFFFF" Visibility="Collapsed">
                                <Border x:Name="HoldFill" HorizontalAlignment="Left" Width="0" CornerRadius="1.5" Background="{DynamicResource AccentGradientH}">
                                    <Border.Effect><DropShadowEffect x:Name="HoldGlowFx" BlurRadius="8" ShadowDepth="0" Opacity="0.9"/></Border.Effect>
                                </Border>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- ===================== PEEK (new track / charging pop-up) ===================== -->
                    <Grid x:Name="PeekView" Opacity="0" Visibility="Collapsed" Margin="12,9,16,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Width="44" Height="44" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform><ScaleTransform x:Name="PeekArtScale"/></Grid.RenderTransform>
                            <Border CornerRadius="12" Background="#1FFFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1">
                                <Border.Effect><DropShadowEffect x:Name="PeekGlowFx" BlurRadius="16" ShadowDepth="0" Opacity="0"/></Border.Effect>
                                <TextBlock x:Name="PeekGlyph" Style="{StaticResource Glyph}" Text="&#xE8D6;" FontSize="18" Foreground="{StaticResource Fg}"/>
                            </Border>
                            <Border x:Name="PeekArt" CornerRadius="12">
                                <Border.Background><ImageBrush x:Name="PeekArtBrush" Stretch="UniformToFill"/></Border.Background>
                            </Border>
                        </Grid>
                        <StackPanel x:Name="PeekText" Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                            <TextBlock x:Name="PeekApp" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource FgFaint}" Margin="0,0,0,1"
                                       TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
                            <TextBlock x:Name="PeekTitle" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="PeekSub" FontSize="11.5" Foreground="{StaticResource FgDim}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                        </StackPanel>
                        <ui:EqualizerBars x:Name="PeekEq" Grid.Column="2" BarHeight="18" BarWidth="3.5"/>
                    </Grid>

                    <!-- ===================== POWER (charger plugged / unplugged) ===================== -->
                    <Grid x:Name="ChargeView" Opacity="0" Visibility="Collapsed" Margin="14,10,20,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Width="66" Height="46">
                            <!-- ripples -->
                            <Ellipse x:Name="ChargeRing1" Width="38" Height="38" Stroke="#FF30D158" StrokeThickness="1.4" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform><ScaleTransform x:Name="ChargeRing1Scale"/></Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse x:Name="ChargeRing2" Width="38" Height="38" Stroke="#FF30D158" StrokeThickness="1.4" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform><ScaleTransform x:Name="ChargeRing2Scale"/></Ellipse.RenderTransform>
                            </Ellipse>
                            <!-- battery -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="44" Height="22" CornerRadius="6.5" BorderBrush="#99FFFFFF" BorderThickness="1.4" Background="#14FFFFFF">
                                    <Border x:Name="ChargeFill" HorizontalAlignment="Left" Margin="2.4" CornerRadius="4" Width="0" Background="#FF30D158"/>
                                </Border>
                                <Border Width="2.6" Height="8" CornerRadius="0,1.5,1.5,0" Background="#99FFFFFF" Margin="1.2,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Path x:Name="ChargeBolt" Data="M 5.6,0 L 0.6,6.6 L 3.9,6.6 L 3.1,11 L 8.2,4.2 L 4.8,4.2 Z" Stretch="Uniform"
                                  Width="11" Height="16" Fill="White" Stroke="#CC0B3D1C" StrokeThickness="1" Margin="0,0,3,0"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform><ScaleTransform x:Name="ChargeBoltScale"/></Path.RenderTransform>
                                <Path.Effect><DropShadowEffect x:Name="ChargeBoltFx" BlurRadius="10" ShadowDepth="0" Color="#FF30D158" Opacity="0.9"/></Path.Effect>
                            </Path>
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                            <TextBlock x:Name="ChargeTitle" Text="Charging" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock x:Name="ChargeSub" FontSize="11.5" Foreground="{StaticResource FgDim}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <TextBlock x:Name="ChargePct" Grid.Column="2" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="24" FontWeight="SemiBold"
                                   Foreground="#FF5EE082" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- ===================== DEVICE (USB / phone / headset… connected or removed) ===================== -->
                    <Grid x:Name="DeviceView" Opacity="0" Visibility="Collapsed" Margin="10,10,18,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Width="62" Height="46" ClipToBounds="True">
                            <Rectangle x:Name="DeviceCable" Height="3" Width="0" RadiusX="1.5" RadiusY="1.5" Fill="#59FFFFFF"
                                       HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <Ellipse x:Name="DeviceSpark" Width="16" Height="16" Opacity="0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                     Margin="11,0,0,0" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.Fill>
                                    <RadialGradientBrush><GradientStop Color="#FFFFFFFF" Offset="0"/><GradientStop Color="#004DA3FF" Offset="1"/></RadialGradientBrush>
                                </Ellipse.Fill>
                                <Ellipse.RenderTransform><ScaleTransform x:Name="DeviceSparkScale"/></Ellipse.RenderTransform>
                            </Ellipse>
                            <Border x:Name="DeviceIconBox" Width="42" Height="42" CornerRadius="13" HorizontalAlignment="Right"
                                    Background="#1FFFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1">
                                <Border.RenderTransform><TranslateTransform x:Name="DeviceIconX"/></Border.RenderTransform>
                                <TextBlock x:Name="DeviceGlyph" Style="{StaticResource Glyph}" FontSize="18" Foreground="#FF5AB0FF"/>
                            </Border>
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                            <TextBlock x:Name="DeviceTitle" FontSize="13.5" FontWeight="SemiBold"/>
                            <TextBlock x:Name="DeviceSub" FontSize="11.5" Foreground="{StaticResource FgDim}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Border x:Name="DeviceBadge" Grid.Column="2" CornerRadius="9" Padding="9,3" Background="#260A84FF" VerticalAlignment="Center">
                            <TextBlock x:Name="DeviceBadgeText" FontSize="10.5" FontWeight="SemiBold" Foreground="#FF5AB0FF"/>
                        </Border>
                    </Grid>

                    <!-- ===================== EXPANDED ===================== -->
                    <Grid x:Name="ExpandedView" Opacity="0" Visibility="Collapsed" Margin="18,6,18,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- header -->
                        <Grid>
                            <Grid HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-6,0,0,0">
                                <Canvas IsHitTestVisible="False">
                                    <Border x:Name="TabIndicator" Height="28" Width="70" CornerRadius="10"
                                            Background="{StaticResource GlassFill}" BorderBrush="{StaticResource GlassStroke}" BorderThickness="1">
                                        <Border.RenderTransform><TranslateTransform x:Name="TabIndicatorX"/></Border.RenderTransform>
                                    </Border>
                                </Canvas>
                                <StackPanel x:Name="TabStrip" Orientation="Horizontal">
                                    <RadioButton x:Name="TabMedia" Style="{StaticResource TabButton}" GroupName="tabs" Tag="0" IsChecked="True" Checked="Tab_Checked" ToolTip="Media">
                                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE8D6;" FontSize="12.5"/><TextBlock Style="{StaticResource TabLabel}" Text="Media"/></StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="TabChats" Style="{StaticResource TabButton}" GroupName="tabs" Tag="4" Checked="Tab_Checked" ToolTip="Chats">
                                        <StackPanel Orientation="Horizontal">
                                            <Grid>
                                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE8BD;" FontSize="12.5"/>
                                                <Ellipse x:Name="ChatsBadge" Width="6" Height="6" Fill="#FF30D158" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-3,0" Visibility="Collapsed"/>
                                            </Grid>
                                            <TextBlock Style="{StaticResource TabLabel}" Text="Chats"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="TabSearch" Style="{StaticResource TabButton}" GroupName="tabs" Tag="5" Checked="Tab_Checked" ToolTip="Search &amp; play music">
                                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" FontSize="12.5"/><TextBlock Style="{StaticResource TabLabel}" Text="Search"/></StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="TabActivity" Style="{StaticResource TabButton}" GroupName="tabs" Tag="6" Checked="Tab_Checked" ToolTip="Claude, ChatGPT &amp; VS Code activity">
                                        <StackPanel Orientation="Horizontal"><Grid><TextBlock Style="{StaticResource Glyph}" Text="&#xE945;" FontSize="12.5"/><Ellipse x:Name="ActivityBadge" Width="6" Height="6" Fill="#FF0A84FF" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-3,0" Visibility="Collapsed"/></Grid><TextBlock Style="{StaticResource TabLabel}" Text="Activity"/></StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="TabApps" Style="{StaticResource TabButton}" GroupName="tabs" Tag="1" Checked="Tab_Checked" ToolTip="Apps">
                                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE71D;" FontSize="12.5"/><TextBlock Style="{StaticResource TabLabel}" Text="Apps"/></StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="TabShelf" Style="{StaticResource TabButton}" GroupName="tabs" Tag="2" Checked="Tab_Checked" ToolTip="Shelf">
                                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE8B7;" FontSize="12.5"/><TextBlock Style="{StaticResource TabLabel}" Text="Shelf"/></StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="TabPower" Style="{StaticResource TabButton}" GroupName="tabs" Tag="3" Checked="Tab_Checked" ToolTip="Control">
                                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE7E8;" FontSize="12.5"/><TextBlock Style="{StaticResource TabLabel}" Text="Control"/></StackPanel>
                                    </RadioButton>
                                </StackPanel>
                            </Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Grid x:Name="HeadCamDot" Width="8" Height="8" Margin="0,0,10,0" Visibility="Collapsed" ToolTip="Gesture camera is watching">
                                    <Ellipse Fill="{StaticResource GradCamera}">
                                        <Ellipse.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#FF30D158" Opacity="0.9"/></Ellipse.Effect>
                                    </Ellipse>
                                </Grid>
                                <TextBlock x:Name="HeadDate" FontSize="12" Foreground="{StaticResource FgFaint}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock x:Name="HeadTime" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <local:BatteryIndicator x:Name="HeadBattery"/>
                            </StackPanel>
                        </Grid>

                        <!-- ===== MEDIA ===== -->
                        <Grid x:Name="MediaPanel" Grid.Row="1" Margin="0,10,0,0">
                            <StackPanel x:Name="MediaEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                                <Grid Width="54" Height="54">
                                    <Ellipse Fill="{StaticResource GlassFill}" Stroke="{StaticResource GlassStroke}"/>
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8D6;" FontSize="22" Foreground="{StaticResource FgDim}"/>
                                </Grid>
                                <TextBlock Text="Nothing playing" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,3"/>
                                <TextBlock Text="Play something in Chrome, Spotify, VLC or any media app" FontSize="11.5"
                                           Foreground="{StaticResource FgDim}" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <Grid x:Name="MediaContent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="122"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- artwork with colour glow -->
                                <Grid x:Name="ArtHost" Width="104" Height="104" HorizontalAlignment="Left" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform><ScaleTransform x:Name="ArtScale"/></Grid.RenderTransform>
                                    <Border CornerRadius="20" Background="{DynamicResource AccentGradient}">
                                        <Border.Effect><DropShadowEffect x:Name="ArtGlowFx" BlurRadius="40" ShadowDepth="4" Direction="270" Opacity="0.7"/></Border.Effect>
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8D6;" FontSize="34" Foreground="#B3000000"/>
                                    </Border>
                                    <Border x:Name="BigThumb" CornerRadius="20">
                                        <Border.Background><ImageBrush x:Name="BigThumbBrush" Stretch="UniformToFill"/></Border.Background>
                                    </Border>
                                    <Border CornerRadius="20" BorderThickness="1" IsHitTestVisible="False">
                                        <Border.BorderBrush>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#40FFFFFF" Offset="0"/>
                                                <GradientStop Color="#08FFFFFF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.BorderBrush>
                                    </Border>
                                </Grid>

                                <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                    <Grid>
                                        <StackPanel x:Name="TrackInfo" Margin="0,0,92,0">
                                            <TextBlock x:Name="TrackTitle" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <ui:EqualizerBars x:Name="HeadEq" BarHeight="10" BarWidth="2" Margin="0,0,7,0"/>
                                                <TextBlock x:Name="TrackArtist" FontSize="12" Foreground="{StaticResource FgDim}" TextTrimming="CharacterEllipsis" MaxWidth="260"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Button x:Name="SourceChip" Style="{StaticResource TileButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Padding="9,3" Click="Source_Click" ToolTip="Media source — click to switch">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="AppName" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource FgDim}"/>
                                                <TextBlock x:Name="SourceMore" Style="{StaticResource Glyph}" Text="&#xE8AB;" FontSize="9" Margin="6,0,0,0"
                                                           Foreground="{StaticResource FgDim}" Visibility="Collapsed"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <!-- progress -->
                                    <Grid Margin="0,13,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="38"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="38"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="PosText" FontSize="10" Foreground="{StaticResource FgDim}" VerticalAlignment="Center"/>
                                        <Grid x:Name="ProgHost" Grid.Column="1" Height="16" Background="Transparent" Cursor="Hand"
                                              MouseLeftButtonDown="Progress_Click" MouseEnter="Progress_Enter" MouseLeave="Progress_Leave">
                                            <Border x:Name="ProgTrack" Height="4" CornerRadius="2" Background="#24FFFFFF" VerticalAlignment="Center"
                                                    RenderTransformOrigin="0.5,0.5">
                                                <Border.RenderTransform><ScaleTransform x:Name="ProgTrackScale"/></Border.RenderTransform>
                                                <Border x:Name="ProgFill" HorizontalAlignment="Left" Width="0" CornerRadius="2" Background="{DynamicResource AccentGradientH}">
                                                    <Border.Effect><DropShadowEffect x:Name="ProgGlowFx" BlurRadius="10" ShadowDepth="0" Opacity="0.85"/></Border.Effect>
                                                </Border>
                                            </Border>
                                            <Ellipse x:Name="ProgKnob" Width="12" Height="12" Fill="White" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                     Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                                                <Ellipse.RenderTransform>
                                                    <TransformGroup>
                                                        <ScaleTransform x:Name="ProgKnobScale" ScaleX="0.4" ScaleY="0.4"/>
                                                        <TranslateTransform x:Name="ProgKnobX"/>
                                                    </TransformGroup>
                                                </Ellipse.RenderTransform>
                                                <Ellipse.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.6" Color="White"/></Ellipse.Effect>
                                            </Ellipse>
                                        </Grid>
                                        <TextBlock x:Name="DurText" Grid.Column="2" FontSize="10" Foreground="{StaticResource FgDim}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <!-- transport -->
                                    <Grid Margin="0,6,0,0">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-6,0,0,0">
                                            <Button Style="{StaticResource IconButton}" Width="40" Height="36" Click="Prev_Click" ToolTip="Previous">
                                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE892;" FontSize="15"/>
                                            </Button>
                                            <Button Style="{StaticResource PlayButton}" Width="40" Height="40" Margin="4,0" Click="PlayPause_Click" ToolTip="Play / pause">
                                                <TextBlock x:Name="PlayGlyph" Style="{StaticResource Glyph}" Text="&#xE768;" FontSize="16" RenderTransformOrigin="0.5,0.5">
                                                    <TextBlock.RenderTransform><ScaleTransform x:Name="PlayGlyphScale"/></TextBlock.RenderTransform>
                                                </TextBlock>
                                            </Button>
                                            <Button Style="{StaticResource IconButton}" Width="40" Height="36" Click="Next_Click" ToolTip="Next">
                                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE893;" FontSize="15"/>
                                            </Button>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <ToggleButton x:Name="LyricsToggle" Style="{StaticResource ChipToggle}" Click="Lyrics_Click"
                                                          ToolTip="Synced lyrics (automatic for Spotify)">
                                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE8D2;" FontSize="10" Margin="0,0,5,0"/><TextBlock Text="Lyrics"/></StackPanel>
                                            </ToggleButton>
                                            <ToggleButton x:Name="CcToggle" Style="{StaticResource ChipToggle}" Margin="6,0,0,0" Click="Cc_Click"
                                                          ToolTip="Live captions for YouTube, Chrome and any audio (Windows Live Captions)">
                                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE7F0;" FontSize="10" Margin="0,0,5,0"/><TextBlock Text="CC"/></StackPanel>
                                            </ToggleButton>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <!-- ===== lyrics / captions stage ===== -->
                                <Border x:Name="LineBox" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0" CornerRadius="18" Height="86"
                                        BorderBrush="{StaticResource GlassStroke}" BorderThickness="1" Visibility="Collapsed">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#12FFFFFF" Offset="0"/>
                                            <GradientStop Color="#05FFFFFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Grid ClipToBounds="True">
                                        <!-- soft spotlight in the artwork colour behind the sung line -->
                                        <Ellipse Width="380" Height="70" IsHitTestVisible="False" Opacity="0.9">
                                            <Ellipse.Fill>
                                                <RadialGradientBrush>
                                                    <GradientStop x:Name="SpotStop" Color="#40FFFFFF" Offset="0"/>
                                                    <GradientStop Color="#00000000" Offset="1"/>
                                                </RadialGradientBrush>
                                            </Ellipse.Fill>
                                        </Ellipse>

                                        <!-- small "LYRICS / LIVE CC" tag -->
                                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,8,0,0" CornerRadius="6" Padding="6,1.5"
                                                Background="{DynamicResource AccentSoft}">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse x:Name="LineTagDot" Width="5" Height="5" Fill="{DynamicResource Accent}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="LineTag" Text="LYRICS" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource Fg}"/>
                                            </StackPanel>
                                        </Border>

                                        <StackPanel x:Name="LineStack" VerticalAlignment="Center" Margin="70,0">
                                            <StackPanel.OpacityMask>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#33000000" Offset="0"/>
                                                    <GradientStop Color="#FF000000" Offset="0.3"/>
                                                    <GradientStop Color="#FF000000" Offset="0.7"/>
                                                    <GradientStop Color="#33000000" Offset="1"/>
                                                </LinearGradientBrush>
                                            </StackPanel.OpacityMask>
                                            <TextBlock x:Name="LinePrev" FontSize="11.5" Foreground="{StaticResource FgFaint}" TextTrimming="CharacterEllipsis"
                                                       HorizontalAlignment="Center" Margin="0,0,0,3"/>
                                            <!-- current line: crisp karaoke text over a blurred neon copy -->
                                            <Grid HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                                <Grid.RenderTransform><ScaleTransform x:Name="LineMainScale"/></Grid.RenderTransform>
                                                <TextBlock x:Name="LineGlow" FontSize="17" FontWeight="Bold" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource AccentGradientH}" Opacity="0.55" IsHitTestVisible="False">
                                                    <TextBlock.Effect><BlurEffect Radius="14" RenderingBias="Performance"/></TextBlock.Effect>
                                                </TextBlock>
                                                <TextBlock x:Name="LineMain" FontSize="17" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                            <TextBlock x:Name="LineNext" FontSize="11.5" Foreground="{StaticResource FgDim}" TextTrimming="CharacterEllipsis"
                                                       HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- ===== CHATS (WhatsApp / Instagram … from notifications) ===== -->
                        <Grid x:Name="ChatsPanel" Grid.Row="1" Margin="0,10,0,0" Visibility="Collapsed">
                            <StackPanel x:Name="ChatsEmpty" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Border Width="46" Height="46" CornerRadius="23" Background="#1FFFFFFF" HorizontalAlignment="Center">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8BD;" FontSize="19"/>
                                </Border>
                                <TextBlock Text="No messages yet" FontSize="14.5" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,3"/>
                                <TextBlock Text="WhatsApp and Instagram messages you receive will show up here, ready to reply"
                                           FontSize="11.5" Foreground="{StaticResource FgDim}" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- list of conversations -->
                            <ScrollViewer x:Name="ChatsListHost" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                                <ItemsControl x:Name="ChatsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource RowButton}" Margin="0,0,0,6" Padding="10,8"
                                                    Click="ChatRow_Click" Tag="{Binding}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid Width="34" Height="34">
                                                        <Border CornerRadius="17" Background="#26FFFFFF">
                                                            <TextBlock Text="{Binding Initial}" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <Image Source="{Binding Icon}" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-2"/>
                                                    </Grid>
                                                    <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding LastText}" FontSize="11.5" Foreground="{StaticResource FgDim}" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding Subtitle}" FontSize="10" Foreground="{StaticResource FgFaint}" HorizontalAlignment="Right"/>
                                                        <Border Background="#FF30D158" CornerRadius="7" MinWidth="14" Height="14" HorizontalAlignment="Right" Margin="0,4,0,0"
                                                                Visibility="{Binding HasUnread}" Padding="4,0">
                                                            <TextBlock Text="{Binding Unread}" FontSize="9.5" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- one conversation + reply box -->
                            <Grid x:Name="ChatView" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Margin="0,0,0,6">
                                    <Button Style="{StaticResource IconButton}" Width="26" Height="26" HorizontalAlignment="Left" Click="ChatBack_Click" ToolTip="All chats">
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE72B;" FontSize="11"/>
                                    </Button>
                                    <StackPanel Margin="34,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="ChatTitle" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="320"/>
                                        <TextBlock x:Name="ChatApp" FontSize="11" Foreground="{StaticResource FgFaint}" Margin="8,1,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                                <ScrollViewer x:Name="ChatScroll" Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                                    <ItemsControl x:Name="ChatMessages">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="bubble" HorizontalAlignment="{Binding Align}" MaxWidth="380" Margin="0,0,0,5" Padding="11,6"
                                                        CornerRadius="14" Background="#24FFFFFF">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Text}" FontSize="12.5" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding TimeText}" FontSize="9.5" Foreground="{StaticResource FgFaint}" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Mine}" Value="True">
                                                        <Setter TargetName="bubble" Property="Background" Value="#FF1F8A3E"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <Grid Grid.Row="2" Margin="0,6,0,0">
                                    <Border CornerRadius="17" Background="#1AFFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1" Height="34" Margin="0,0,42,0">
                                        <Grid>
                                            <TextBlock x:Name="ReplyHint" Text="Reply…" FontSize="12.5" Foreground="{StaticResource FgFaint}" Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                            <TextBox x:Name="ReplyBox" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Fg}" CaretBrush="{StaticResource Fg}"
                                                     FontSize="12.5" Margin="10,0" VerticalAlignment="Center" PreviewMouseDown="TypingBox_MouseDown"
                                                     TextChanged="ReplyBox_TextChanged" KeyDown="ReplyBox_KeyDown" LostKeyboardFocus="TypingBox_LostFocus"/>
                                        </Grid>
                                    </Border>
                                    <Button x:Name="ReplySend" Style="{StaticResource PlayButton}" Width="34" Height="34" HorizontalAlignment="Right" Click="ReplySend_Click" ToolTip="Send">
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE724;" FontSize="13" Foreground="Black"/>
                                    </Button>
                                </Grid>
                                <TextBlock x:Name="ReplyStatus" Grid.Row="2" FontSize="10.5" Foreground="{StaticResource FgFaint}" Margin="14,40,0,-16" Visibility="Collapsed"/>
                            </Grid>
                        </Grid>

                        <!-- ===== MUSIC SEARCH (YouTube, plays inside the notch) ===== -->
                        <Grid x:Name="SearchPanel" Grid.Row="1" Margin="0,10,0,0" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border CornerRadius="18" Background="#1AFFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1" Height="38">
                                <Grid>
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" FontSize="13" Foreground="{StaticResource FgDim}" HorizontalAlignment="Left" Margin="14,0,0,0"/>
                                    <TextBlock x:Name="SearchHint" Text="Search a song or artist — it plays right here" FontSize="13" Foreground="{StaticResource FgFaint}"
                                               Margin="38,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                    <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Fg}" CaretBrush="{StaticResource Fg}"
                                             FontSize="13" Margin="34,0,40,0" VerticalAlignment="Center" PreviewMouseDown="TypingBox_MouseDown"
                                             TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown" LostKeyboardFocus="TypingBox_LostFocus"/>
                                    <ui:EqualizerBars x:Name="SearchSpinner" BarHeight="12" BarWidth="2.5" HorizontalAlignment="Right" Margin="0,0,14,0" Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                            <ScrollViewer x:Name="ResultsScroll" Grid.Row="1" Margin="0,8,0,0" VerticalScrollBarVisibility="Hidden">
                                <ItemsControl x:Name="ResultsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource RowButton}" Margin="0,0,0,5" Padding="6" Click="Result_Click" Tag="{Binding}" ToolTip="Play in the notch">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid Width="78" Height="44">
                                                        <Border CornerRadius="9" Background="#1FFFFFFF">
                                                            <Border.Clip><RectangleGeometry Rect="0,0,78,44" RadiusX="9" RadiusY="9"/></Border.Clip>
                                                            <Image Source="{Binding Thumb}" Stretch="UniformToFill"/>
                                                        </Border>
                                                        <Border Background="#CC000000" CornerRadius="5" Padding="4,0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,4">
                                                            <TextBlock Text="{Binding Length}" FontSize="9.5" FontWeight="SemiBold"/>
                                                        </Border>
                                                        <Border CornerRadius="9" Background="#99000000" Visibility="{Binding PlayingVisibility}">
                                                            <ui:EqualizerBars BarHeight="14" BarWidth="2.5" IsPlaying="True" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </Grid>
                                                    <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Meta}" FontSize="11" Foreground="{StaticResource FgDim}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="2" Width="30" Height="30" CornerRadius="15" Background="White" Margin="0,0,4,0">
                                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE768;" FontSize="12" Foreground="Black" Margin="2,0,0,0"/>
                                                    </Border>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <StackPanel x:Name="SearchEmpty" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="SearchEmptyText" Text="Type a song — results appear as you type and play inside the notch" FontSize="11.5"
                                           Foreground="{StaticResource FgFaint}" HorizontalAlignment="Center"/>
                                <Button x:Name="SearchOpenYt" Style="{StaticResource ChipButton}" Margin="0,10,0,0" HorizontalAlignment="Center" Click="SearchOpenYt_Click" Visibility="Collapsed">
                                    <TextBlock Text="Open on YouTube instead" FontSize="11"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- ===== ACTIVITY (Claude Code, Claude, ChatGPT, VS Code, Antigravity, terminals) ===== -->
                        <Grid x:Name="ActivityPanel" Grid.Row="1" Margin="0,8,0,0" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- summary header -->
                            <Grid Margin="2,0,2,8">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Grid Width="10" Height="10" Margin="0,0,8,0">
                                        <Ellipse x:Name="ActivityPulse" Fill="#FF5EE0A8" RenderTransformOrigin="0.5,0.5">
                                            <Ellipse.RenderTransform><ScaleTransform x:Name="ActivityPulseScale"/></Ellipse.RenderTransform>
                                        </Ellipse>
                                        <Ellipse Fill="#FF5EE0A8" Width="6" Height="6"/>
                                    </Grid>
                                    <TextBlock x:Name="ActivitySummary" Text="All quiet" FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock Text="Claude · ChatGPT · VS Code · Antigravity · terminals" FontSize="10.5" Foreground="{StaticResource FgFaint}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <StackPanel x:Name="ActivityEmpty" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Border Width="46" Height="46" CornerRadius="23" Background="#1FFFFFFF" HorizontalAlignment="Center">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE945;" FontSize="19"/>
                                </Border>
                                <TextBlock Text="Nothing running" FontSize="14.5" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,3"/>
                                <TextBlock Text="Claude Code, Claude, ChatGPT, VS Code, Antigravity and terminal jobs show up here while they work"
                                           FontSize="11.5" Foreground="{StaticResource FgDim}" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                                <ItemsControl x:Name="ActivityList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource RowButton}" Margin="0,0,0,7" Padding="0" Click="Activity_Click" Tag="{Binding}">
                                                <Grid Opacity="{Binding CardOpacity}">
                                                    <!-- working: brand-coloured glow edge + a slow light sweep across the card -->
                                                    <Border CornerRadius="13" BorderThickness="1" BorderBrush="{Binding BrandBrush}" Opacity="0.5" Visibility="{Binding WorkingVisibility}">
                                                        <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.35" Color="White"/></Border.Effect>
                                                    </Border>
                                                    <Border CornerRadius="13" Visibility="{Binding WorkingVisibility}">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.35">
                                                                <GradientStop Color="#00FFFFFF" Offset="0.32"/>
                                                                <GradientStop Color="#16FFFFFF" Offset="0.5"/>
                                                                <GradientStop Color="#00FFFFFF" Offset="0.68"/>
                                                                <LinearGradientBrush.RelativeTransform><TranslateTransform X="-1"/></LinearGradientBrush.RelativeTransform>
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                        <Border.Triggers>
                                                            <EventTrigger RoutedEvent="Loaded">
                                                                <BeginStoryboard><Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(Border.Background).(Brush.RelativeTransform).(TranslateTransform.X)"
                                                                                     From="-1" To="1.2" Duration="0:0:2.4" RepeatBehavior="Forever">
                                                                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                </Storyboard></BeginStoryboard>
                                                            </EventTrigger>
                                                        </Border.Triggers>
                                                    </Border>

                                                    <Grid Margin="11,10,12,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- app icon with an orbiting comet ring while working, ✓ badge when done -->
                                                        <Grid Width="42" Height="42" VerticalAlignment="Top">
                                                            <Border Width="32" Height="32" CornerRadius="10" Background="{Binding BrandSoft}">
                                                                <Grid>
                                                                    <Image Source="{Binding Icon}" Width="20" Height="20" Visibility="{Binding IconVisibility}" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                    <TextBlock Text="{Binding Initial}" FontWeight="Bold" FontSize="13" Foreground="{Binding BrandBrush}"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding InitialVisibility}"/>
                                                                </Grid>
                                                            </Border>
                                                            <Ellipse Width="41" Height="41" StrokeThickness="2.4" Stroke="{Binding BrandRing}" StrokeDashArray="11 6"
                                                                     StrokeDashCap="Round" Visibility="{Binding WorkingVisibility}" RenderTransformOrigin="0.5,0.5">
                                                                <Ellipse.RenderTransform><RotateTransform/></Ellipse.RenderTransform>
                                                                <Ellipse.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.8" Color="White"/></Ellipse.Effect>
                                                                <Ellipse.Triggers>
                                                                    <EventTrigger RoutedEvent="Loaded">
                                                                        <BeginStoryboard><Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360"
                                                                                             Duration="0:0:1.4" RepeatBehavior="Forever"/>
                                                                        </Storyboard></BeginStoryboard>
                                                                    </EventTrigger>
                                                                </Ellipse.Triggers>
                                                            </Ellipse>
                                                            <Border Width="15" Height="15" CornerRadius="7.5" Background="#FF30D158" BorderBrush="#FF111114" BorderThickness="2"
                                                                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2" Visibility="{Binding DoneVisibility}">
                                                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE73E;" FontSize="7" Foreground="Black" FontWeight="Bold"/>
                                                            </Border>
                                                        </Grid>

                                                        <StackPanel Grid.Column="1" Margin="10,1,10,0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding App}" FontSize="13" FontWeight="SemiBold"/>
                                                                <TextBlock Text="{Binding Title}" FontSize="11.5" Foreground="{StaticResource FgFaint}" Margin="7,1.5,0,0"
                                                                           TextTrimming="CharacterEllipsis" MaxWidth="250"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Detail}" FontSize="11.5" Foreground="{StaticResource FgDim}" TextWrapping="Wrap" MaxHeight="34"
                                                                       TextTrimming="CharacterEllipsis" Margin="0,3,0,0" FontFamily="Segoe UI Variable Text, Segoe UI"/>
                                                        </StackPanel>

                                                        <!-- status: brand pill with typing dots + live timer while working -->
                                                        <StackPanel Grid.Column="2" VerticalAlignment="Top" HorizontalAlignment="Right">
                                                            <Border CornerRadius="9" Padding="8,2" Background="{Binding BrandSoft}" Visibility="{Binding WorkingVisibility}">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                                                                        <StackPanel.Resources>
                                                                            <Style TargetType="Ellipse">
                                                                                <Setter Property="Width" Value="4"/>
                                                                                <Setter Property="Height" Value="4"/>
                                                                                <Setter Property="Margin" Value="1,0"/>
                                                                            </Style>
                                                                        </StackPanel.Resources>
                                                                        <Ellipse Fill="{Binding BrandBrush}">
                                                                            <Ellipse.Triggers><EventTrigger RoutedEvent="Loaded"><BeginStoryboard><Storyboard RepeatBehavior="Forever">
                                                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity" Duration="0:0:1.1">
                                                                                    <LinearDoubleKeyFrame Value="0.25" KeyTime="0:0:0"/><LinearDoubleKeyFrame Value="1" KeyTime="0:0:0.25"/><LinearDoubleKeyFrame Value="0.25" KeyTime="0:0:0.55"/>
                                                                                </DoubleAnimationUsingKeyFrames></Storyboard></BeginStoryboard></EventTrigger></Ellipse.Triggers>
                                                                        </Ellipse>
                                                                        <Ellipse Fill="{Binding BrandBrush}">
                                                                            <Ellipse.Triggers><EventTrigger RoutedEvent="Loaded"><BeginStoryboard><Storyboard RepeatBehavior="Forever">
                                                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity" Duration="0:0:1.1">
                                                                                    <LinearDoubleKeyFrame Value="0.25" KeyTime="0:0:0.15"/><LinearDoubleKeyFrame Value="1" KeyTime="0:0:0.4"/><LinearDoubleKeyFrame Value="0.25" KeyTime="0:0:0.7"/>
                                                                                </DoubleAnimationUsingKeyFrames></Storyboard></BeginStoryboard></EventTrigger></Ellipse.Triggers>
                                                                        </Ellipse>
                                                                        <Ellipse Fill="{Binding BrandBrush}">
                                                                            <Ellipse.Triggers><EventTrigger RoutedEvent="Loaded"><BeginStoryboard><Storyboard RepeatBehavior="Forever">
                                                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity" Duration="0:0:1.1">
                                                                                    <LinearDoubleKeyFrame Value="0.25" KeyTime="0:0:0.3"/><LinearDoubleKeyFrame Value="1" KeyTime="0:0:0.55"/><LinearDoubleKeyFrame Value="0.25" KeyTime="0:0:0.85"/>
                                                                                </DoubleAnimationUsingKeyFrames></Storyboard></BeginStoryboard></EventTrigger></Ellipse.Triggers>
                                                                        </Ellipse>
                                                                    </StackPanel>
                                                                    <TextBlock Text="{Binding Elapsed}" FontSize="10.5" FontWeight="SemiBold" Foreground="{Binding BrandBrush}"
                                                                               Typography.NumeralAlignment="Tabular"/>
                                                                </StackPanel>
                                                            </Border>
                                                            <Border CornerRadius="9" Padding="8,2" Background="#2630D158" Visibility="{Binding DoneVisibility}">
                                                                <TextBlock Text="Done" FontSize="10.5" FontWeight="SemiBold" Foreground="#FF5EE082"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding When}" FontSize="10" Foreground="{StaticResource FgFaint}" HorizontalAlignment="Right" Margin="0,4,2,0"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <!-- ===== APPS ===== -->
                        <Grid x:Name="AppsPanel" Grid.Row="1" Margin="0,12,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="AppsEmpty" Text="No open windows" Foreground="{StaticResource FgDim}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                            <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Margin="0,4,0,0">
                                <ItemsControl x:Name="AppsList" ItemTemplate="{StaticResource AppTile}" ItemsPanel="{StaticResource Wrap}"/>
                            </ScrollViewer>
                        </Grid>

                        <!-- ===== SHELF ===== -->
                        <Grid x:Name="ShelfPanel" Grid.Row="1" Margin="0,12,0,0" Visibility="Collapsed">
                            <Grid x:Name="ShelfEmpty">
                                <Rectangle RadiusX="16" RadiusY="16" Stroke="#40FFFFFF" StrokeThickness="1.5" StrokeDashArray="4 3" Fill="#08FFFFFF"/>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Grid Width="50" Height="50">
                                        <Ellipse Fill="{StaticResource GradSleep}">
                                            <Ellipse.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="0" Color="#FFBF5AF2" Opacity="0.18"/></Ellipse.Effect>
                                        </Ellipse>
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE896;" FontSize="20"/>
                                    </Grid>
                                    <TextBlock Text="Drop files here" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,3"/>
                                    <TextBlock Text="Drag anything onto the notch — it waits here until you drag it out again"
                                               FontSize="11.5" Foreground="{StaticResource FgDim}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                            <Grid x:Name="ShelfFilled" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="24"/>
                                </Grid.RowDefinitions>
                                <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Margin="0,4,0,0">
                                    <ItemsControl x:Name="ShelfList" ItemTemplate="{StaticResource ShelfTile}" ItemsPanel="{StaticResource Wrap}"/>
                                </ScrollViewer>
                                <TextBlock Grid.Row="1" Text="Double-click to open · drag out to use · right-click to show in folder"
                                           FontSize="10.5" Foreground="{StaticResource FgFaint}" VerticalAlignment="Center"/>
                                <Button Grid.Row="1" Style="{StaticResource IconButton}" HorizontalAlignment="Right" Padding="10,3" Click="ShelfClear_Click">
                                    <TextBlock Text="Clear all" FontSize="10.5" Foreground="{StaticResource FgDim}"/>
                                </Button>
                            </Grid>
                            <!-- drop target: glowing marching-ants border -->
                            <Grid x:Name="DropOverlay" IsHitTestVisible="False" Visibility="Collapsed" Opacity="0">
                                <Border CornerRadius="16" Background="{DynamicResource AccentSoft}"/>
                                <Rectangle x:Name="DropAnts" RadiusX="16" RadiusY="16" Stroke="{DynamicResource AccentGradientH}" StrokeThickness="2" StrokeDashArray="5 4">
                                    <Rectangle.Effect><DropShadowEffect x:Name="DropGlowFx" BlurRadius="16" ShadowDepth="0" Opacity="0.9"/></Rectangle.Effect>
                                </Rectangle>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE896;" FontSize="24" RenderTransformOrigin="0.5,0.5">
                                        <TextBlock.RenderTransform><TranslateTransform x:Name="DropArrowY"/></TextBlock.RenderTransform>
                                    </TextBlock>
                                    <TextBlock Text="Drop to keep it on the shelf" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- ===== CONTROL ===== -->
                        <Grid x:Name="PowerPanel" Grid.Row="1" Margin="0,12,0,0" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="80"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <UniformGrid Columns="4">
                                <Button Style="{StaticResource TileButton}" Margin="0,0,6,0" Click="Lock_Click" ToolTip="Lock — or close your hand ✊ near the camera">
                                    <StackPanel>
                                        <Grid Width="36" Height="36"><Ellipse Fill="{StaticResource GradLock}"><Ellipse.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="0" Color="#FF40A0FF" Opacity="0.18"/></Ellipse.Effect></Ellipse><TextBlock Style="{StaticResource Glyph}" Text="&#xE72E;" FontSize="15"/></Grid>
                                        <TextBlock Text="Lock" FontSize="11.5" FontWeight="SemiBold" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource TileButton}" Margin="3,0,3,0" Click="Sleep_Click" ToolTip="Sleep">
                                    <StackPanel>
                                        <Grid Width="36" Height="36"><Ellipse Fill="{StaticResource GradSleep}"><Ellipse.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="0" Color="#FFBF5AF2" Opacity="0.18"/></Ellipse.Effect></Ellipse><TextBlock Style="{StaticResource Glyph}" Text="&#xE708;" FontSize="15"/></Grid>
                                        <TextBlock Text="Sleep" FontSize="11.5" FontWeight="SemiBold" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource TileButton}" Margin="3,0,3,0" Click="Restart_Click" ToolTip="Restart — or raise an open hand 🖐 near the camera">
                                    <StackPanel>
                                        <Grid Width="36" Height="36"><Ellipse Fill="{StaticResource GradRestart}"><Ellipse.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="0" Color="#FFFF9F0A" Opacity="0.18"/></Ellipse.Effect></Ellipse><TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" FontSize="15"/></Grid>
                                        <TextBlock Text="Restart" FontSize="11.5" FontWeight="SemiBold" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource TileButton}" Margin="6,0,0,0" Click="Shutdown_Click" ToolTip="Shut down">
                                    <StackPanel>
                                        <Grid Width="36" Height="36"><Ellipse Fill="{StaticResource GradPower}"><Ellipse.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="0" Color="#FFFF453A" Opacity="0.18"/></Ellipse.Effect></Ellipse><TextBlock Style="{StaticResource Glyph}" Text="&#xE7E8;" FontSize="15"/></Grid>
                                        <TextBlock Text="Shut down" FontSize="11.5" FontWeight="SemiBold" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </UniformGrid>

                            <Grid Grid.Row="1" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- gesture card -->
                                <Border CornerRadius="14" Background="{StaticResource GlassFill}" BorderBrush="{StaticResource GlassStroke}" BorderThickness="1" Padding="10,8"
                                        VerticalAlignment="Top">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="30" Height="30">
                                            <Ellipse Fill="{StaticResource GradCamera}"/>
                                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE722;" FontSize="13"/>
                                        </Grid>
                                        <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="Hand gestures" FontSize="12.5" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="GestureStatus" FontSize="10.5" Foreground="{StaticResource FgDim}" TextTrimming="CharacterEllipsis"
                                                       Text="✊ close hand = lock  ·  🖐 open palm = restart"/>
                                            <ToggleButton x:Name="PreviewChip" Style="{StaticResource ChipToggle}" HorizontalAlignment="Left" Margin="0,6,0,0"
                                                          Click="PreviewChip_Click" ToolTip="Show the live camera with hand tracking in a small corner window">
                                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE714;" FontSize="10" Margin="0,0,5,0"/><TextBlock Text="Camera preview"/></StackPanel>
                                            </ToggleButton>
                                        </StackPanel>
                                        <CheckBox x:Name="GestureSwitch" Grid.Column="2" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="GestureSwitch_Click"/>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox x:Name="StartupSwitch" Style="{StaticResource Switch}" Click="StartupSwitch_Click"/>
                                        <TextBlock Text="Start with Windows" FontSize="11" Foreground="{StaticResource FgDim}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <CheckBox x:Name="TalkSwitch" Style="{StaticResource Switch}" Click="TalkSwitch_Click"/>
                                        <TextBlock Text="Eyes talk" FontSize="11" Foreground="{StaticResource FgDim}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <CheckBox x:Name="StandbySwitch" Style="{StaticResource Switch}" Click="StandbySwitch_Click"
                                                  ToolTip="Show the big clock after 5 minutes away"/>
                                        <Button Style="{StaticResource ChipButton}" Margin="8,0,0,0" Click="StandbyNow_Click" ToolTip="Show the standby clock now">
                                            <TextBlock Text="Standby clock" FontSize="11"/>
                                        </Button>
                                    </StackPanel>
                                    <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" Padding="10,4" Margin="0,6,0,0" Click="Quit_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" FontSize="9" Foreground="{StaticResource FgDim}" Margin="0,0,6,0"/>
                                            <TextBlock Text="Quit notch" FontSize="11" Foreground="{StaticResource FgDim}"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- ===== RESTART / SHUTDOWN COUNTDOWN ===== -->
                        <Grid x:Name="CountdownOverlay" Grid.RowSpan="2" Margin="-18,-6,-18,-16" Visibility="Collapsed" Opacity="0" Background="Black">
                            <Rectangle IsHitTestVisible="False">
                                <Rectangle.Fill>
                                    <RadialGradientBrush GradientOrigin="0.5,0.4" Center="0.5,0.4" RadiusX="0.55" RadiusY="0.85">
                                        <GradientStop x:Name="CountdownGlowStop" Color="#55FF453A" Offset="0"/>
                                        <GradientStop Color="#00FF453A" Offset="1"/>
                                    </RadialGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Grid Width="70" Height="70" HorizontalAlignment="Center">
                                    <Ellipse Stroke="#1FFFFFFF" StrokeThickness="4"/>
                                    <Ellipse x:Name="CountdownRing" StrokeThickness="4" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5" StrokeDashArray="16.5 100">
                                        <Ellipse.Stroke>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#FFFF9F0A" Offset="0"/>
                                                <GradientStop Color="#FFFF453A" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Ellipse.Stroke>
                                        <Ellipse.RenderTransform><RotateTransform Angle="-90"/></Ellipse.RenderTransform>
                                        <Ellipse.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="0" Color="#FFFF453A" Opacity="0.9"/></Ellipse.Effect>
                                    </Ellipse>
                                    <TextBlock x:Name="CountdownNumber" Text="5" FontSize="28" FontWeight="Bold" RenderTransformOrigin="0.5,0.5"
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.RenderTransform><ScaleTransform x:Name="CountdownNumberScale"/></TextBlock.RenderTransform>
                                    </TextBlock>
                                </Grid>
                                <TextBlock x:Name="CountdownTitle" Text="Restarting in 5 s" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,3"/>
                                <TextBlock x:Name="CountdownSub" FontSize="11.5" Foreground="{StaticResource FgDim}" HorizontalAlignment="Center"
                                           Text="Close your hand ✊ or press Cancel to stop"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                                    <Button Style="{StaticResource TileButton}" Padding="24,8" Click="CountdownCancel_Click">
                                        <TextBlock Text="Cancel" FontWeight="SemiBold"/>
                                    </Button>
                                    <Button Style="{StaticResource TileButton}" Padding="18,8" Margin="8,0,0,0" Background="{StaticResource GradPower}" Click="CountdownNow_Click">
                                        <TextBlock x:Name="CountdownNowText" Text="Restart now" FontWeight="SemiBold"/>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <Path x:Name="EarR" Data="M12,0 L0,0 L0,12 A12,12 0 0 1 12,0 Z" Fill="Black" VerticalAlignment="Top" Width="12" Height="12"/>
        </StackPanel>

        <!-- ===== macOS-style notification banner: drops out of the notch and floats just below it ===== -->
        <Grid x:Name="Banner" HorizontalAlignment="Center" VerticalAlignment="Top" Width="372" Margin="0,44,0,0" Visibility="Collapsed"
              Background="Transparent" Cursor="Hand" MouseLeftButtonUp="Banner_Click" MouseEnter="Banner_MouseEnter" MouseLeave="Banner_MouseLeave">
            <!-- the droplet that falls out of the notch and blooms into the card -->
            <Ellipse x:Name="BannerDrop" Width="18" Height="18" Fill="Black" HorizontalAlignment="Center" VerticalAlignment="Top" Opacity="0"
                     IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5" Stroke="#30FFFFFF" StrokeThickness="0.8">
                <Ellipse.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="BannerDropScale"/>
                        <TranslateTransform x:Name="BannerDropY"/>
                    </TransformGroup>
                </Ellipse.RenderTransform>
            </Ellipse>
            <!-- a card peeking out underneath when more are waiting -->
            <Border x:Name="BannerStack" Margin="16,0,16,-7" VerticalAlignment="Bottom" Height="22" CornerRadius="0,0,16,16"
                    Background="#E6222227" BorderBrush="#24FFFFFF" BorderThickness="1,0,1,1" Visibility="Collapsed" IsHitTestVisible="False"/>
            <Grid x:Name="BannerCard" RenderTransformOrigin="0.5,0" Opacity="0">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="BannerScale"/>
                        <TranslateTransform x:Name="BannerY"/>
                    </TransformGroup>
                </Grid.RenderTransform>
                <Grid.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="9" Direction="270" Opacity="0.42"/></Grid.Effect>
                <Grid x:Name="BannerGlass">
                    <!-- frosted: a blurred picture of what's behind the card -->
                    <Image x:Name="BannerBackdrop" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Top" IsHitTestVisible="False">
                        <Image.Effect><BlurEffect Radius="46" KernelType="Gaussian" RenderingBias="Quality"/></Image.Effect>
                    </Image>
                    <Rectangle Fill="#9E1B1B1F"/>
                    <Rectangle IsHitTestVisible="False">
                        <Rectangle.Fill>
                            <RadialGradientBrush Center="0.1,0.15" GradientOrigin="0.1,0.15" RadiusX="0.7" RadiusY="1.4">
                                <GradientStop x:Name="BannerTintStop" Color="#4030D158" Offset="0"/>
                                <GradientStop Color="#0030D158" Offset="1"/>
                            </RadialGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Rectangle IsHitTestVisible="False">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#16FFFFFF" Offset="0"/>
                                <GradientStop Color="#00FFFFFF" Offset="0.55"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Border x:Name="BannerRim" CornerRadius="20" BorderBrush="#30FFFFFF" BorderThickness="1" IsHitTestVisible="False"/>

                    <Grid Margin="12,11,14,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Width="40" Height="40" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform><ScaleTransform x:Name="BannerIconScale"/></Grid.RenderTransform>
                            <Border CornerRadius="11" Background="#24FFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1">
                                <TextBlock x:Name="BannerGlyph" Style="{StaticResource Glyph}" Text="&#xEA8F;" FontSize="17"/>
                            </Border>
                            <Image x:Name="BannerIcon" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>
                        <StackPanel x:Name="BannerText" Grid.Column="1" Margin="11,0,0,0">
                            <Grid>
                                <TextBlock x:Name="BannerApp" FontSize="11" FontWeight="SemiBold" Foreground="#B3F5F5F7" TextTrimming="CharacterEllipsis" Margin="0,0,52,0"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Border x:Name="BannerMore" CornerRadius="7" Background="#2EFFFFFF" Padding="6,0" Margin="0,0,6,0" Visibility="Collapsed">
                                        <TextBlock x:Name="BannerMoreText" FontSize="9.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="now" FontSize="10.5" Foreground="{StaticResource FgFaint}"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="BannerTitle" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                            <TextBlock x:Name="BannerBody" FontSize="12.5" Foreground="#D9F5F5F7" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34" Margin="0,1,0,0"/>
                        </StackPanel>
                        <!-- actions slide in on hover -->
                        <StackPanel x:Name="BannerActions" Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="11,0,0,0" Height="0" Opacity="0">
                            <Button x:Name="BannerReply" Style="{StaticResource ChipButton}" Click="BannerReply_Click" Margin="0,8,6,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE97A;" FontSize="10" Margin="0,0,5,0"/>
                                    <TextBlock Text="Reply" FontSize="11" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ChipButton}" Click="BannerOpen_Click" Margin="0,8,0,0">
                                <TextBlock x:Name="BannerOpenText" Text="Open" FontSize="11" FontWeight="SemiBold"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
                <!-- macOS-style close button, top-left corner, on hover -->
                <Border x:Name="BannerClose" Width="20" Height="20" CornerRadius="10" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-6,-6,0,0"
                        Background="#F23A3A40" BorderBrush="#40FFFFFF" BorderThickness="1" Opacity="0" MouseLeftButtonUp="BannerClose_Click">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" FontSize="8" Foreground="{StaticResource Fg}"/>
                </Border>
            </Grid>
        </Grid>

        <!-- the eyes' speech bubble (pops out under the pill) -->
        <Grid x:Name="Bubble" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,38,0,0" Visibility="Collapsed"
              IsHitTestVisible="False" RenderTransformOrigin="0.5,0">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="BubbleScale"/>
                    <TranslateTransform x:Name="BubbleY"/>
                </TransformGroup>
            </Grid.RenderTransform>
            <Grid.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.45"/></Grid.Effect>
            <Path Data="M0,7 C4,7 5,0 7,0 C9,0 10,7 14,7 Z" Fill="#FA1E1E24" HorizontalAlignment="Center" VerticalAlignment="Top" Width="14" Height="7"/>
            <Border Margin="0,6,0,0" CornerRadius="15" Background="#FA1E1E24" BorderBrush="#2EFFFFFF" BorderThickness="1" Padding="13,6,13,7">
                <TextBlock x:Name="BubbleText" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Fg}"/>
            </Border>
        </Grid>
    </Grid>
</Window>
